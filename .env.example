# ── Client-side (bundled into the frontend) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Server-side only (NEVER prefix with VITE_) ──
# Admin password for the dashboard. Used by the serverless API.
ADMIN_PASSWORD=your-secure-admin-password

# Supabase service role key — full database access, used by admin API & Discord bot.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Discord bot integration (optional)
DISCORD_PUBLIC_KEY=your-discord-public-key
