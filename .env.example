# ── Client-side (bundled into the frontend) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile site key (optional — bot protection on admin login)
# Get yours free at: https://dash.cloudflare.com → Turnstile
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ── Server-side only (NEVER prefix with VITE_) ──
# Admin password for the dashboard. Used by the serverless API.
ADMIN_PASSWORD=your-secure-admin-password

# Supabase service role key — full database access, used by admin API & Discord bot.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile secret key (optional — server-side bot verification)
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Discord bot integration (optional)
DISCORD_PUBLIC_KEY=your-discord-public-key

# Discord command registration script (optional — used by scripts/register-discord-commands.js)
DISCORD_APP_ID=your-discord-app-id
DISCORD_TOKEN=your-discord-bot-token

# Vercel Cron secret (optional — protects the auto-archive cron endpoint)
# Vercel auto-generates this for you, or set your own for local testing
CRON_SECRET=your-cron-secret
